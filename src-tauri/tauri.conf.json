{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Coocoo",
  "mainBinaryName": "coocoo-desktop",
  "identifier": "dev.coocoo.app",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": {
      "script": "npm run dev",
      "cwd": "../ui",
      "wait": false
    },
    "beforeBuildCommand": {
      "script": "npm run build",
      "cwd": "../ui"
    }
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": {
        "default-src": "'self'",
        "connect-src": "'self' ipc: http://ipc.localhost ws://127.0.0.1:* ws://localhost:* http://127.0.0.1:* http://localhost:*",
        "img-src": "'self' data: blob: http://127.0.0.1:* http://localhost:*",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self' data:",
        "script-src": "'self'",
        "object-src": "'none'",
        "base-uri": "'self'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "appimage",
      "dmg",
      "app",
      "nsis"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Run many omp coding agents in parallel across all your machines",
    "longDescription": "Coocoo is an agentic development environment: run many omp coding agents in parallel, in git worktrees, across desktops and headless servers, with live status, diffs, a streamed agent browser and phone/web access.",
    "icon": [
      "icons/128x128.png",
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "license": "MIT"
  }
}
